# Copy these into the app's Secrets on Streamlit Community Cloud (Settings > Secrets).
# Never commit real values. Without these sections the app runs as the public search tool only.

[auth]
redirect_uri = "https://grant-matcher.streamlit.app/oauth2callback"
cookie_secret = "a long random string"
client_id = "from Google Cloud > APIs & Services > Credentials"
client_secret = "from the same Google OAuth client"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[workspace]
repo = "RendellRich/grant-matcher-workspace"      # private repo that stores saved work
github_token = "fine-grained token with Contents read and write on that repo only"
allowed_emails = ["you@example.org"]               # who can open the workspace

[anthropic]
api_key = "your Claude API key"
