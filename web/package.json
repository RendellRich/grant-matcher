{
  "name": "grant-matcher-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "model": "node scripts/fetch-model.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:fn": "vite build --ssr ../supabase/functions/search/index.ts --outDir ../supabase/functions/search/dist --emptyOutDir --logLevel warn",
    "score-eto": "vite build --ssr scripts/score-eto.ts --outDir .score-eto --emptyOutDir --logLevel warn && node .score-eto/score-eto.js",
    "build:digest": "vite build --ssr ../supabase/functions/weekly-email/index.ts --outDir ../supabase/functions/weekly-email/dist --emptyOutDir --logLevel warn",
    "build:reminders": "vite build --ssr ../supabase/functions/deadline-reminders/index.ts --outDir ../supabase/functions/deadline-reminders/dist --emptyOutDir --logLevel warn"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@huggingface/transformers": "^4.3.2",
    "@supabase/supabase-js": "^2.119.2",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
